# Root Monorepo Environment Variables Template
NODE_ENV=development

# PostgreSQL Connection String
DATABASE_URL=postgresql://moneytracker:moneytracker_dev_password@localhost:5432/moneytracker_dev?schema=public

# API Configuration
PORT=4000
API_BASE_URL=http://localhost:4000/api/v1
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Firebase Admin Configuration (For Backend & Migration)
FIREBASE_PROJECT_ID=money-spending-tracker
# Optional: Path or inline JSON string of Service Account Key
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
