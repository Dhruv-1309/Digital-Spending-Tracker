{
  "name": "@moneytracker/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./currency": {
      "types": "./dist/src/currency/paise.d.ts",
      "import": "./dist/src/currency/paise.js",
      "default": "./dist/src/currency/paise.js"
    },
    "./schemas": {
      "types": "./dist/src/schemas/index.d.ts",
      "import": "./dist/src/schemas/index.js",
      "default": "./dist/src/schemas/index.js"
    },
    "./types": {
      "types": "./dist/src/types/index.d.ts",
      "import": "./dist/src/types/index.js",
      "default": "./dist/src/types/index.js"
    },
    "./calculations": {
      "types": "./dist/src/calculations/index.d.ts",
      "import": "./dist/src/calculations/index.js",
      "default": "./dist/src/calculations/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "fast-check": "^4.10.2",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  }
}
