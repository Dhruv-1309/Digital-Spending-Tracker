{
  "name": "@moneytracker/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:analyze": "node -e \"process.env.ANALYZE='true'; require('child_process').execSync('vite build', {stdio:'inherit', env: process.env})\"",
    "lint": "eslint .",
    "test": "vitest run",
    "test:a11y": "vitest run src/test/a11y_axe.test.tsx",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@moneytracker/shared": "*",
    "chart.js": "^4.5.1",
    "firebase": "^13.0.0",
    "motion": "^14.9.0",
    "react": "^19.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.14.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.30",
    "rollup-plugin-visualizer": "^7.1.2",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.46.4",
    "vite": "npm:rolldown-vite@7.2.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5",
    "@grpc/grpc-js": "^1.14.7"
  }
}
