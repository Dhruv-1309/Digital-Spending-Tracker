# Environment Configuration for MoneyTracker API
PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://moneytracker:moneytracker_dev_password@localhost:5432/moneytracker_dev?schema=public"

# Firebase Admin Configuration
# Set either FIREBASE_SERVICE_ACCOUNT_JSON (JSON string) or path to service account file
FIREBASE_PROJECT_ID="digital-spending-tracker"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@digital-spending-tracker.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# CORS configuration (comma separated origins)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173"

# Cloudflare Turnstile Bot Protection Secret Key (SEC-19)
# Use official Cloudflare test secret key for local development (always passes):
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Soft-Delete Tombstone Retention (BE-18) & Graceful Shutdown (BE-19)
TOMBSTONE_RETENTION_DAYS=90
SHUTDOWN_TIMEOUT_MS=10000
